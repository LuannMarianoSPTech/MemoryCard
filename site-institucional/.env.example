# Copie este arquivo para .env (producao) e .env.dev (desenvolvimento)
# e preencha com os dados do seu banco. Nunca suba o .env real para o Git.
AMBIENTE_PROCESSO=desenvolvimento

# Configurações de conexão com o banco de dados
DB_HOST='localhost'
DB_DATABASE='memorycard'
DB_USER='seu_usuario'
DB_PASSWORD='sua_senha'
DB_PORT=3306

# Configurações do servidor de aplicação
APP_PORT=3333
APP_HOST=localhost
